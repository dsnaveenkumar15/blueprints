# Shared by web and batch. Copy to .env. Blueprints serves only BLUEPRINTS_HOST; the other hosts are used for footer links.
TRUST_HOST=trust.naveenlabs.tech
RADAR_HOST=radar.naveenlabs.tech
BLUEPRINTS_HOST=blueprints.naveenlabs.tech
PUBLIC_SCHEME=https
PUBLIC_PORT=
ADMIN_USER=owner
# 16+ characters; /admin is disabled (404) while this is the default or shorter.
ADMIN_PASSWORD=change-me
PLANET_MODULES=blueprints.jobs
BLUEPRINTS_MODEL=sonnet
WEIGHTS=blueprints=100
KUMA_PUSH_URL=
# Where Trust's and Radar's published data is read from. Defaults to DATA_ROOT; docker-compose.siblings.yml mounts the sibling
# apps' data volumes read-only at these paths. With nothing there, Blueprints shows its empty states.
# TRUST_DATA_ROOT=/trust-data
# RADAR_DATA_ROOT=/radar-data
# Architect agent (/architect). Off unless ARCHITECT_ENABLED=1 with a key and at least one fast model. OpenRouter ids,
# primary first. PUBLIC models (free tiers may keep prompts) run only after the visitor ticks the not-confidential box.
ARCHITECT_ENABLED=0
OPENROUTER_API_KEY=
ARCHITECT_FAST_MODELS=deepseek/deepseek-v4.1-flash
ARCHITECT_STRONG_MODELS=z-ai/glm-5.3-flash
ARCHITECT_PUBLIC_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free
ARCHITECT_PRICES=
ARCHITECT_RUN_USD=0.08
ARCHITECT_DAILY_USD=0.25
ARCHITECT_FREE_CALLS_DAY=900
